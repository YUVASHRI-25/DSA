   "source": [
    "def fibonacci_iterative(n):\n",
    "    sequence = []\n",
    "    a, b = 0, 1\n",
    "    for _ in range(n):\n",
    "        sequence.append(a)\n",
    "        a, b = b, a + b\n",
    "    return sequence\n",
    "\n",
    "num = int(input(\"Enter the number: \"))\n",
    "print(fibonacci_iterative(num))"
   ]
  }
