   "source": [
    "n = int(input(\"Enter number of elements: \"))\n",
    "arr = []\n",
    "\n",
    "for i in range(n):\n",
    "    arr.append(int(input(f\"Enter element {i+1}: \")))\n",
    "\n",
    "print(\"Original array:\", arr)\n",
    "print(\"Reversed array:\", arr[::-1])"
   ]
  }
