   "source": [
    "#Counting frequencies of array elements\n",
    "class Solution:\n",
    "    def maxFrequencyElements(self, nums: List[int]) -> int:\n",
    "        f=Counter(nums)\n",
    "        maxf=max(f.values())\n",
    "        return sum(c for c in f.values() if c==maxf)"
   ]
  }
